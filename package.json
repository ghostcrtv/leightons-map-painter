{
  "name": "leightons-map-painter",
  "version": "0.1.0",
  "description": "Leighton’s Map Painter — a single-player world map painting and strategy game",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "prepare-data": "node scripts/prepare-data.mjs && node scripts/make-icons.mjs && node scripts/make-notices.mjs",
    "notices": "node scripts/make-notices.mjs",
    "stats": "node scripts/make-stats.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "polylabel": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "flag-icons": "^7.6.0",
    "i18n-iso-countries": "^7.14.0",
    "pngjs": "^7.0.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  }
}
